# Supabase project URL and server-side secret key. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"
# Older Supabase projects can use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.

# JWT signing secret (generate a random value with at least 32 characters).
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Optional external face recognition endpoint. If unset, the app uses its labeled mock service.
FACE_RECOGNITION_API_URL=""
FACE_RECOGNITION_API_KEY=""

# Required only to seed a Supabase project. Choose strong unique passwords.
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_PASSWORD=""
