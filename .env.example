POSTGRES_HOST_PORT="5432"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
FACE_RECOGNITION_API_URL=""
FACE_RECOGNITION_API_KEY=""

# Required only when seeding a production database. Use strong, unique passwords.
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_PASSWORD=""
